NODE_ENV=production
APP_ORIGIN=https://YOUR-DOMAIN.example
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
ADMIN_EMAIL=
SETUP_TOKEN=
UNEGUI_SYNC_ENABLED=true
QPAY_ENABLED=false
QPAY_BASE_URL=https://merchant.qpay.mn
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_SITE_ORIGIN=https://YOUR-DOMAIN.example
# Google sign-in: OAuth client (Web application), redirect URI https://YOUR-DOMAIN.example/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook Login: Meta app (Consumer), Valid OAuth Redirect URI https://YOUR-DOMAIN.example/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Facebook page ad import (Admin -> "Зар, төлбөр" -> "Facebook пейжийн зар"). Daily at 08:00 Ulaanbaatar.
# Page posts with a photo and a phone number become listings owned by ADMIN_EMAIL.
# Set by deploy/set-facebook-page.sh (never-expiring page token from the Darkhanzar app).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
# First run reads posts from this date onward.
FACEBOOK_IMPORT_SINCE=2026-10-01T00:00:00+08:00
